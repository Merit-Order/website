---
import Base from '../layouts/Base.astro';
import { intro, checkedOn, header, rows, aside, notes, closing, cell } from '../lib/featuresheet.js';
---
<Base title="Compare" description={`How Merit Order compares with LiteLLM, OpenRouter's Auto Router, Cloudflare AI Gateway, Portkey, Not Diamond, RouteLLM, Kong, Requesty and Helicone, checked on ${checkedOn}, with sources.`}>
<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">Compare</p>
    <h1>How it compares, with sources.</h1>
    <p class="sub">Nine other gateways and routers, checked against their public docs on {checkedOn}. Where others are ahead is below the table. This page is the feature sheet's comparison, pulled from the main repository at build time.</p>
  </div>
</section>

<section class="sec" style="padding-top:0;border-top:0" aria-labelledby="table-h">
  <div class="wrap">
    <h2 id="table-h" class="sr-only">Comparison table</h2>
    <p class="prose" set:html={intro}></p>
    <div class="table-wrap" style="margin-top:20px" tabindex="0" role="region" aria-label="Comparison table, scrolls sideways">
      <table class="cmp cmp-full">
        <thead><tr>{header.map((h, i) => <th scope="col" class={i === 1 ? 'mo' : undefined}>{h}</th>)}</tr></thead>
        <tbody>
          {rows.map((r) => (
            <tr>{r.map((c, i) => i === 0 ? <th scope="row" style="font-weight:500;text-align:left;white-space:normal;background:transparent;color:var(--fg);font-size:13.5px" set:html={cell(c)}></th>
              : <td class:list={{ mo: i === 1, n: c.startsWith('✗') }} set:html={cell(c)}></td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
    {aside.map((p) => <p class="src" set:html={p}></p>)}

    <div class="two" style="margin-top:48px">
      <div class="prose">
        {closing.map((b) => b.list ? <ul>{b.list.map((li) => <li set:html={li}></li>)}</ul> : <p set:html={b.p}></p>)}
      </div>
      <div>
        <h3 style="font-size:19px;margin-bottom:10px">Notes</h3>
        <ol class="notes">
          {notes.map((n) => <li id={`note-${n.n}`} value={n.n} set:html={n.html}></li>)}
        </ol>
      </div>
    </div>
  </div>
</section>
</Base>
<style>
  .cmp-full .fn { color: var(--muted); text-decoration: none; font-size: 12px; margin-left: 2px; }
  .cmp-full .fn:hover { color: var(--accent-text); }
  .prose :global(h3) { margin-top: 0; }
  .two .prose > :global(p:first-child) { margin-top: 0; }
</style>
