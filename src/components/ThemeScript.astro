---
// Before first paint, as Starlight's ThemeProvider does: the stored choice, else the system setting.
---
<script is:inline>
(() => {
  let t = ''; try { t = localStorage.getItem('starlight-theme') || ''; } catch {}
  document.documentElement.dataset.theme = t === 'light' || t === 'dark' ? t
    : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
})();
</script>
