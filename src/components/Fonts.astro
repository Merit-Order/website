---
// Geist and Geist Mono (SIL Open Font License 1.1), served from this site: no font CDN.
import sans from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import sansExt from '@fontsource-variable/geist/files/geist-latin-ext-wght-normal.woff2?url';
import mono from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url';
import monoExt from '@fontsource-variable/geist-mono/files/geist-mono-latin-ext-wght-normal.woff2?url';
const latin = 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2190-21FF,U+2212,U+2215,U+FEFF,U+FFFD';
const ext = 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF';
const css = `
@font-face{font-family:Geist;font-style:normal;font-display:swap;font-weight:100 900;src:url(${sans}) format('woff2');unicode-range:${latin}}
@font-face{font-family:Geist;font-style:normal;font-display:swap;font-weight:100 900;src:url(${sansExt}) format('woff2');unicode-range:${ext}}
@font-face{font-family:"Geist Mono";font-style:normal;font-display:swap;font-weight:100 900;src:url(${mono}) format('woff2');unicode-range:${latin}}
@font-face{font-family:"Geist Mono";font-style:normal;font-display:swap;font-weight:100 900;src:url(${monoExt}) format('woff2');unicode-range:${ext}}`;
---
<link rel="preload" href={sans} as="font" type="font/woff2" crossorigin />
<style is:inline set:html={css}></style>
